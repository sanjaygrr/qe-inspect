&CONTROL
  calculation = 'vc-relax'
  prefix = 'vcrelax_ok'
  outdir = './tmp_vcrelax_ok'
  pseudo_dir = './pseudo'
  
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.9
  nat = 1
  ntyp = 1
  ecutwfc = 20.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  
/
&ELECTRONS
  diagonalization = 'cg'
  conv_thr = 1.0d-8
  
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
  Al 26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS {alat}
Al 0.0 0.0 0.0
K_POINTS {automatic}
  6 6 6 0 0 0
