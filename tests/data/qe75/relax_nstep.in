&CONTROL
  calculation = 'relax'
  prefix = 'relax_nstep'
  outdir = './tmp_relax_nstep'
  pseudo_dir = './pseudo'
  nstep = 3
/
&SYSTEM
  ibrav = 1
  celldm(1) = 7.652
  nat = 2
  ntyp = 1
  ecutwfc = 20.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  
/
&ELECTRONS
  diagonalization = 'cg'
  conv_thr = 1.0d-8
  
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
  Al 26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS {alat}
Al 0.0 0.0 0.0
Al 0.42 0.5 0.5
K_POINTS {automatic}
  4 4 4 0 0 0
