&CONTROL
  calculation = 'scf'
  prefix = 'crash_nbnd'
  outdir = './tmp_crash_nbnd'
  pseudo_dir = './pseudo'
  
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.652
  nat = 1
  ntyp = 1
  ecutwfc = 20.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  nbnd = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
  Al 26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS {alat}
Al 0.0 0.0 0.0
K_POINTS {automatic}
  4 4 4 0 0 0
